# Drop monitor backend configuration
# Copy this file to .env and adjust the values before running the server.

# Port (use 3000 for Docker/Coolify, 4110 for local dev)
DROP_PORT=4110
# Relative paths are resolved from the project root (this repo root)
# For Docker: use /app/data/drop-monitor.db (volume mounted)
DROP_DB_PATH=./skrypty/drop-monitor-backend/data/drop-monitor.db
# Comma-separated list of origins allowed to call the API
DROP_ALLOWED_ORIGINS=https://eclesiar.com,https://www.eclesiar.com
# Comma-separated API keys. Leave empty to disable auth (not recommended)
DROP_API_KEYS=change-me-super-secret-key
